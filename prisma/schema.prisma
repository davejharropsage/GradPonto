// Prisma schema for PlacementPilot
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  INTERESTED
  NOT_STARTED
  PREPARING
  APPLIED
  ONLINE_ASSESSMENT
  VIDEO_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentKind {
  CV
  COVER_LETTER
}

enum ActivityType {
  INTERVIEW
  TASK
  NOTE
  FOLLOW_UP
  STATUS_CHANGE
}

enum Plan {
  FREE
  PRO
}

enum Role {
  USER
  ADMIN
}

// A registered person. They sign in with `email` + `passwordHash`. `email` is proven once, at
// signup, by entering a one-time code (see LoginCode); the account exists as soon as that
// verification completes, and `registeredAt` is set once they've also given their name and
// university — the app is only usable after that.
//
// Every row of user data below (Employer, Application, Document, Goal,
// Activity) belongs to exactly one User via `userId`. Always read and write
// them through the scoped client from `userDb()` in src/lib/auth, which
// injects `userId` for you, never through the raw Prisma client.
model User {
  id              String    @id @default(cuid())
  email           String    @unique // stored lower-cased; also the sign-in identifier
  // Null only for an account that predates password sign-in and hasn't set one yet — resolved via
  // the forgot-password flow (src/lib/actions/auth.ts), which works identically whether this is
  // null (first time) or already set (an ordinary reset). See src/lib/auth/password.ts for the
  // scrypt-based hash/verify functions.
  passwordHash    String?
  name            String?
  university      String?
  plan            Plan      @default(FREE)
  // Set to ADMIN only ever by matching ADMIN_EMAILS on sign-in (see upsertVerifiedUser) — never
  // set back to USER automatically, so it can't silently demote an admin managed another way later.
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  registeredAt    DateTime?
  lastLoginAt     DateTime?
  // Set by an admin (suspendUser in src/lib/actions/admin.ts). A suspended user is signed out
  // immediately (their Sessions are deleted) and any further sign-in attempt is blocked.
  suspendedAt     DateTime?

  sessions     Session[]
  employers    Employer[]
  applications Application[]
  documents    Document[]
  goals        Goal[]
  activities   Activity[]
  experiences  Experience[]
  educations   Education[]
  skills       Skill[]
  projects     Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 hash
// is stored here, so a copy of the database can't be used to hijack sessions.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A one-time code emailed to `email`, either to verify it at signup or to authorise a password
// reset (see `purpose`) — never to sign in directly any more. Only an HMAC of the code is stored.
// Codes expire, are single-use, and lock after too many wrong guesses.
model LoginCode {
  id         String          @id @default(cuid())
  email      String
  purpose    LoginCodePurpose @default(SIGNUP)
  codeHash   String
  expiresAt  DateTime
  attempts   Int             @default(0)
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([email, purpose, createdAt])
}

enum LoginCodePurpose {
  SIGNUP
  RESET
}

model Employer {
  id       String  @id @default(cuid())
  name     String
  website  String?
  industry String?
  notes    String?

  // Optional recruiter/hiring-contact details. All independent and optional — set only the ones
  // you have.
  contactName  String?
  contactRole  String?
  contactEmail String?
  contactPhone String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

model Application {
  id          String            @id @default(cuid())
  title       String
  location    String?
  jobUrl      String?
  description String? // the job posting text, used as tailoring input
  source      String? // e.g. "university portal", "LinkedIn", referral
  salary      String? // free text, e.g. "£24,000" or "£350/week"
  deadline    DateTime?
  status      ApplicationStatus @default(INTERESTED)
  priority    Priority          @default(MEDIUM)
  appliedAt   DateTime?
  notes       String?

  // Independent of status: hides the application from the default active
  // view without deleting it or implying it was rejected/withdrawn.
  archived Boolean @default(false)

  employer   Employer? @relation(fields: [employerId], references: [id])
  employerId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  documents  Document[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([employerId])
  @@index([status])
  @@index([deadline])
  @@index([archived])
}

model Document {
  id             String       @id @default(cuid())
  kind           DocumentKind
  isBase         Boolean      @default(false) // base documents have applicationId = null
  // A user-chosen label for a base document, e.g. "Tech CV" vs "Consulting CV" — several base
  // documents of the same kind are allowed on purpose, so this is how they're told apart.
  // Null on older/unnamed documents and on tailored (non-base) copies, which are labelled by
  // their application instead.
  name           String?
  content        String // markdown / plain text
  generatedByAI  Boolean      @default(false)
  // Which cover-letter tone template (lib/labels.ts's coverLetterTemplates) produced this
  // document, if any — shown as a badge so you know which style you're looking at. Always null
  // for CVs and for a plain duplicate (only an AI-generated cover letter sets this).
  templateKey    String?

  // A CV built section-by-section (see the Experience/Education/Skill/Project models below)
  // rather than pasted/uploaded as one block. `content` is still the source of truth for
  // everything downstream (AI review, PDF export, tailoring) — it's re-derived from the
  // structured rows on every builder save (lib/cv/serialize.ts), so nothing else in the app
  // ever needs to know a CV was authored this way. headline/summary sit above the sections.
  isStructured Boolean @default(false)
  headline     String?
  summary      String?

  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  experiences Experience[]
  educations  Education[]
  skills      Skill[]
  projects    Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([kind])
}

// One CV section each, owned by a structured Document (Document.isStructured). Every one of
// these carries its own `userId`, the same as Activity does despite also belonging to an
// Application — scopedDb() only auto-scopes models it's told about by name (see
// src/lib/auth/scoped-db.ts's OWNED_MODELS), so each child table needs its own owner column
// rather than relying on the parent Document's.
model Experience {
  id        String    @id @default(cuid())
  title     String
  employer  String
  location  String?
  startDate DateTime?
  endDate   DateTime?
  current   Boolean   @default(false)
  bullets   String // one per line
  order     Int       @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
}

model Education {
  id            String    @id @default(cuid())
  institution   String
  qualification String
  field         String?
  startDate     DateTime?
  endDate       DateTime?
  grade         String?
  order         Int       @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
}

model Skill {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([documentId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  link        String?
  order       Int     @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
}

// A target like "10 applications this month" — progress is always computed
// live from Application.createdAt, never stored, so it can't drift out of
// sync with the actual data.
model Goal {
  id        String   @id @default(cuid())
  target    Int
  startDate DateTime
  endDate   DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([startDate, endDate])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  notes       String?
  // Where it happens, e.g. "Zoom", "Microsoft Teams", or an office address — most useful for
  // INTERVIEW, but not restricted to it (a TASK due "at the careers office" is fine too).
  location    String?
  dueDate     DateTime?
  completedAt DateTime?

  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([dueDate])
}

// Records what an admin did, to whom. Deliberately NOT registered in scoped-db.ts's OWNED_MODELS —
// this is an admin-wide table, not per-user data, on the same footing as User/Session. Only ever
// written/read through the raw prisma client (src/lib/auth/admin.ts's adminDb), after requireAdmin().
model AuditLog {
  id     String @id @default(cuid())
  action String // e.g. "user.suspend", "user.reinstate", "user.impersonate_start", "user.impersonate_stop"

  actorId    String
  // Denormalized so the log still reads sensibly even if the actor's account is later deleted.
  actorEmail String

  targetUserId String?
  targetEmail  String?

  detail String? // short free-text context, e.g. a reason

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

// One row per shared-allowance call (a real Gemini request, a real non-cached Adzuna search),
// so the admin usage dashboard can show today's totals durably — the in-process rate-limit
// counters in src/lib/auth/rate-limit.ts reset on every restart and were never meant to answer
// that. Deliberately NOT registered in scoped-db.ts's OWNED_MODELS, same reasoning as AuditLog.
model UsageEvent {
  id        String   @id @default(cuid())
  kind      String // "AI" | "ADZUNA"
  userId    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}
