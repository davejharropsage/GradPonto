// Prisma schema for PlacementPilot
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  INTERESTED
  NOT_STARTED
  PREPARING
  APPLIED
  ONLINE_ASSESSMENT
  VIDEO_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentKind {
  CV
  COVER_LETTER
}

enum ActivityType {
  INTERVIEW
  TASK
  NOTE
  FOLLOW_UP
  STATUS_CHANGE
}

enum Plan {
  FREE
  PRO
}

// Single-row table holding the local user's display name and plan.
// There is no authentication in this app (single local user) — this just
// drives the dashboard greeting and the "Pro" upsell state.
model Profile {
  id   String @id @default("default")
  name String?
  plan Plan    @default(FREE)

  updatedAt DateTime @updatedAt
}

// Captured from the public landing page's sign-up form. Not wired to real
// billing (no Stripe keys) — see ARCHITECTURE.md for what a real
// subscription flow would need.
model Signup {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  plan       Plan     @default(FREE)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt  DateTime @default(now())
}

model Employer {
  id       String  @id @default(cuid())
  name     String
  website  String?
  industry String?
  notes    String?

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Application {
  id          String            @id @default(cuid())
  title       String
  location    String?
  jobUrl      String?
  description String? // the job posting text, used as tailoring input
  source      String? // e.g. "university portal", "LinkedIn", referral
  salary      String? // free text, e.g. "£24,000" or "£350/week"
  deadline    DateTime?
  status      ApplicationStatus @default(INTERESTED)
  priority    Priority          @default(MEDIUM)
  appliedAt   DateTime?
  notes       String?

  // Independent of status: hides the application from the default active
  // view without deleting it or implying it was rejected/withdrawn.
  archived Boolean @default(false)

  employer   Employer? @relation(fields: [employerId], references: [id])
  employerId String?

  documents  Document[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employerId])
  @@index([status])
  @@index([deadline])
  @@index([archived])
}

model Document {
  id             String       @id @default(cuid())
  kind           DocumentKind
  isBase         Boolean      @default(false) // base documents have applicationId = null
  content        String // markdown / plain text
  generatedByAI  Boolean      @default(false)

  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([kind])
}

// A target like "10 applications this month" — progress is always computed
// live from Application.createdAt, never stored, so it can't drift out of
// sync with the actual data.
model Goal {
  id        String   @id @default(cuid())
  target    Int
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  notes       String?
  dueDate     DateTime?
  completedAt DateTime?

  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([dueDate])
}
