// Prisma schema for PlacementPilot
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  INTERESTED
  NOT_STARTED
  PREPARING
  APPLIED
  ONLINE_ASSESSMENT
  VIDEO_INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentKind {
  CV
  COVER_LETTER
}

enum ActivityType {
  INTERVIEW
  TASK
  NOTE
  FOLLOW_UP
  STATUS_CHANGE
}

enum Plan {
  FREE
  PRO
}

// A registered person. Passwordless: they prove they own `email` by entering a
// one-time code (see LoginCode). The account exists as soon as the email is
// verified; `registeredAt` is set once they have also given their name and
// university, and the app is only usable after that.
//
// Every row of user data below (Employer, Application, Document, Goal,
// Activity) belongs to exactly one User via `userId`. Always read and write
// them through the scoped client from `userDb()` in src/lib/auth, which
// injects `userId` for you, never through the raw Prisma client.
model User {
  id              String    @id @default(cuid())
  email           String    @unique // stored lower-cased
  name            String?
  university      String?
  plan            Plan      @default(FREE)
  emailVerifiedAt DateTime?
  registeredAt    DateTime?
  lastLoginAt     DateTime?

  sessions     Session[]
  employers    Employer[]
  applications Application[]
  documents    Document[]
  goals        Goal[]
  activities   Activity[]
  experiences  Experience[]
  educations   Education[]
  skills       Skill[]
  projects     Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 hash
// is stored here, so a copy of the database can't be used to hijack sessions.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A one-time sign-in code emailed to `email`. Only an HMAC of the code is
// stored. Codes expire, are single-use, and lock after too many wrong guesses.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model Employer {
  id       String  @id @default(cuid())
  name     String
  website  String?
  industry String?
  notes    String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

model Application {
  id          String            @id @default(cuid())
  title       String
  location    String?
  jobUrl      String?
  description String? // the job posting text, used as tailoring input
  source      String? // e.g. "university portal", "LinkedIn", referral
  salary      String? // free text, e.g. "£24,000" or "£350/week"
  deadline    DateTime?
  status      ApplicationStatus @default(INTERESTED)
  priority    Priority          @default(MEDIUM)
  appliedAt   DateTime?
  notes       String?

  // Independent of status: hides the application from the default active
  // view without deleting it or implying it was rejected/withdrawn.
  archived Boolean @default(false)

  employer   Employer? @relation(fields: [employerId], references: [id])
  employerId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  documents  Document[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([employerId])
  @@index([status])
  @@index([deadline])
  @@index([archived])
}

model Document {
  id             String       @id @default(cuid())
  kind           DocumentKind
  isBase         Boolean      @default(false) // base documents have applicationId = null
  // A user-chosen label for a base document, e.g. "Tech CV" vs "Consulting CV" — several base
  // documents of the same kind are allowed on purpose, so this is how they're told apart.
  // Null on older/unnamed documents and on tailored (non-base) copies, which are labelled by
  // their application instead.
  name           String?
  content        String // markdown / plain text
  generatedByAI  Boolean      @default(false)
  // Which cover-letter tone template (lib/labels.ts's coverLetterTemplates) produced this
  // document, if any — shown as a badge so you know which style you're looking at. Always null
  // for CVs and for a plain duplicate (only an AI-generated cover letter sets this).
  templateKey    String?

  // A CV built section-by-section (see the Experience/Education/Skill/Project models below)
  // rather than pasted/uploaded as one block. `content` is still the source of truth for
  // everything downstream (AI review, PDF export, tailoring) — it's re-derived from the
  // structured rows on every builder save (lib/cv/serialize.ts), so nothing else in the app
  // ever needs to know a CV was authored this way. headline/summary sit above the sections.
  isStructured Boolean @default(false)
  headline     String?
  summary      String?

  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  experiences Experience[]
  educations  Education[]
  skills      Skill[]
  projects    Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([kind])
}

// One CV section each, owned by a structured Document (Document.isStructured). Every one of
// these carries its own `userId`, the same as Activity does despite also belonging to an
// Application — scopedDb() only auto-scopes models it's told about by name (see
// src/lib/auth/scoped-db.ts's OWNED_MODELS), so each child table needs its own owner column
// rather than relying on the parent Document's.
model Experience {
  id        String    @id @default(cuid())
  title     String
  employer  String
  location  String?
  startDate DateTime?
  endDate   DateTime?
  current   Boolean   @default(false)
  bullets   String // one per line
  order     Int       @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
}

model Education {
  id            String    @id @default(cuid())
  institution   String
  qualification String
  field         String?
  startDate     DateTime?
  endDate       DateTime?
  grade         String?
  order         Int       @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
}

model Skill {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([documentId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  link        String?
  order       Int     @default(0)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([documentId])
}

// A target like "10 applications this month" — progress is always computed
// live from Application.createdAt, never stored, so it can't drift out of
// sync with the actual data.
model Goal {
  id        String   @id @default(cuid())
  target    Int
  startDate DateTime
  endDate   DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([startDate, endDate])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  notes       String?
  dueDate     DateTime?
  completedAt DateTime?

  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Never rely on this default. scopedDb() always sets the real owner; the "" placeholder only
  // makes the field optional in TypeScript. It is not a real user id, so a write that bypasses
  // the scoped client fails the foreign-key check instead of creating misfiled data.
  userId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([dueDate])
}
