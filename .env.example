# Copy to .env and fill in. Never commit .env.
# DATABASE_URL must be an ABSOLUTE path (see ARCHITECTURE.md), for example:
#   DATABASE_URL="file:C:/path/to/Placement-App/prisma/dev.db"
DATABASE_URL="file:./dev.db"

# --- Accounts & sign-in -----------------------------------------------------
# Signs one-time sign-in codes. Required. Use a random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Public address of the site. Used in emails, and cookies are marked Secure when it starts with https://.
APP_URL=http://localhost:3000

# --- Email (sign-in codes and the welcome email) -----------------------------
# Leave SMTP_HOST blank in development: emails are then saved to ./.mail-outbox and shown at
# /dev/outbox instead of being sent. In production SMTP_HOST is REQUIRED (sign-in fails without it).
#
# After filling these in, check it works with:   npm run mail:test -- you@example.com
#
# Quick test with a personal Gmail (needs 2-step verification, then an App Password from
# https://myaccount.google.com/apppasswords ; about 500 emails a day, testing only):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASS=<the 16-character app password, no spaces>
#   MAIL_FROM="GradPonto <you@gmail.com>"      (must be that same Gmail address)
# For a real launch use a transactional email service and a domain you own (Brevo, SMTP2GO,
# Resend, Mailjet all have free plans); they give you the host/user/password to paste below.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465). Leave blank for STARTTLS on 587.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. GradPonto <no-reply@yourdomain.com>. Must be allowed by your SMTP provider.
MAIL_FROM=

# --- Optional AI features ---------------------------------------------------
# Powers Analyse a Job, Check My CV and "Generate with AI". Leave blank to switch them off.
# Free key from Google AI Studio: https://aistudio.google.com/apikey  (keep it secret, never commit it)
GEMINI_API_KEY=
# Optional: choose a different Gemini model (default gemini-3.8-flash).
GEMINI_MODEL=
# Optional fallback, used only when GEMINI_API_KEY is empty: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Job search (Find placements) -------------------------------------------
# Free keys from https://developer.adzuna.com . Without them the Find placements page says search
# isn't set up yet; everything else works. NOTE: the free key allows 25 requests a minute and 250 a
# day for the whole app (all users share it), so results are cached and searches are rate-limited.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: point at a different Adzuna-compatible endpoint (used by tests). Leave blank normally.
ADZUNA_API_BASE=

# --- Admin -------------------------------------------------------------------
# Comma-separated emails granted the admin role the next time they sign in. Only ever promotes —
# never removes the role from someone who already has it. Leave blank for no admins.
ADMIN_EMAILS=
