# Copy to .env and fill in. Never commit .env.
# DATABASE_URL must be an ABSOLUTE path (see ARCHITECTURE.md), for example:
#   DATABASE_URL="file:C:/path/to/Placement-App/prisma/dev.db"
DATABASE_URL="file:./dev.db"

# --- Accounts & sign-in -----------------------------------------------------
# Signs one-time sign-in codes. Required. Use a random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Public address of the site. Used in emails, and cookies are marked Secure when it starts with https://.
APP_URL=http://localhost:3000

# --- Email (sign-in codes and the welcome email) -----------------------------
# Leave SMTP_HOST blank in development: emails are then saved to ./.mail-outbox and shown at
# /dev/outbox instead of being sent. In production SMTP_HOST is REQUIRED (sign-in fails without it).
#
# After filling these in, check it works with:   npm run mail:test -- you@example.com
#
# Quick test with a personal Gmail (needs 2-step verification, then an App Password from
# https://myaccount.google.com/apppasswords ; about 500 emails a day, testing only):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASS=<the 16-character app password, no spaces>
#   MAIL_FROM="GradPonto <you@gmail.com>"      (must be that same Gmail address)
# For a real launch use a transactional email service and a domain you own (Brevo, SMTP2GO,
# Resend, Mailjet all have free plans); they give you the host/user/password to paste below.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465). Leave blank for STARTTLS on 587.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. GradPonto <no-reply@yourdomain.com>. Must be allowed by your SMTP provider.
MAIL_FROM=

# --- Continue with Google / Microsoft (optional) ------------------------------
# Each button stays greyed out ("Soon") until BOTH its keys are set. The redirect URI to register
# with each provider is  APP_URL + /api/auth/oauth/<google|microsoft>/callback , e.g. for local dev
#   http://localhost:3000/api/auth/oauth/google/callback
# and for the live site
#   https://gradponto.com/api/auth/oauth/google/callback
# Step-by-step setup for each provider is in README.md ("Continue with Google / Microsoft").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Email import (optional) ---------------------------------------------------
# Users forward application emails to a private address <token>@INBOUND_EMAIL_DOMAIN. Mail for that
# domain is received by Postmark (an MX record), which posts each email to
#   https://postmark:<INBOUND_WEBHOOK_SECRET>@<your site>/api/inbound/postmark
# The Email import page says "not switched on" until BOTH are set. Setup is in README.md
# ("Email import"). Classification uses the AI key below.
INBOUND_EMAIL_DOMAIN=
# Random, 24+ characters, e.g.  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INBOUND_WEBHOOK_SECRET=

# --- Optional AI features ---------------------------------------------------
# Powers Analyse a Job, Check My CV and "Generate with AI". Leave blank to switch them off.
# Free key from Google AI Studio: https://aistudio.google.com/apikey  (keep it secret, never commit it)
GEMINI_API_KEY=
# Optional: choose a different Gemini model (default gemini-3.8-flash).
GEMINI_MODEL=
# Optional fallback, used only when GEMINI_API_KEY is empty: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Job search (Find placements) -------------------------------------------
# Free keys from https://developer.adzuna.com . Without them the Find placements page says search
# isn't set up yet; everything else works. NOTE: the free key allows 25 requests a minute and 250 a
# day for the whole app (all users share it), so results are cached and searches are rate-limited.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: point at a different Adzuna-compatible endpoint (used by tests). Leave blank normally.
ADZUNA_API_BASE=

# --- Scheduled jobs -------------------------------------------------------------
# Vercel calls /api/cron/process-inbound daily (vercel.json; Hobby plan limit) to classify forwarded emails
# the AI couldn't read when they arrived, sending this as "Authorization: Bearer <CRON_SECRET>".
# Random, e.g.  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Sentry error tracking (optional) ------------------------------------------
# Off until NEXT_PUBLIC_SENTRY_DSN is set. Create the Sentry project in the EU data region. The DSN
# is read at BUILD time for the browser, so redeploy after setting or changing it. Not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build time only: upload source maps so stack traces show real file names and lines.
# The token IS a secret (Sentry → Settings → Auth Tokens, scope project:releases / org:read).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Alerts and daily spending caps -------------------------------------------
# Where alert emails go: AI outages, a daily cap being reached, and unexpected errors when Sentry
# isn't set up (at most one email an hour per problem). Comma-separated. Blank = ADMIN_EMAILS.
ALERT_EMAIL=
# Daily caps (UTC days), counted in the database. Leave blank for the defaults shown; see
# OWNERS_GUIDE.md ("Spending limits").
# AI requests for the whole site (default 1000) and per person (default 100)
AI_DAILY_LIMIT=
AI_DAILY_LIMIT_PER_USER=
# Job searches (default 200; Adzuna's free key allows 250)
ADZUNA_DAILY_LIMIT=
# Emails sent over SMTP (default 250)
MAIL_DAILY_LIMIT=
# Emails received by Email import, whole site (default 1000) and per person (default 150)
INBOUND_DAILY_LIMIT=
INBOUND_DAILY_LIMIT_PER_USER=

# --- Admin -------------------------------------------------------------------
# Comma-separated emails granted the admin role the next time they sign in. Only ever promotes —
# never removes the role from someone who already has it. Leave blank for no admins.
ADMIN_EMAILS=
